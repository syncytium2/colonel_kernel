{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "bash tools/murderboard_freshness.sh --hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash tools/murderboard_freshness.sh --hook --label session-protocol --slug syncytium2/murderboard --file docs/session_protocol.md --file .claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "bash tools/murderboard_freshness.sh --hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash tools/murderboard_freshness.sh --hook --label session-protocol --slug syncytium2/murderboard --file docs/session_protocol.md --file .claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/no-heredoc-source.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/send-goes-nowhere.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
