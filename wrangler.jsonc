{
  // Cloudflare Workers config — serves the Vite build in dist/ as static assets.
  // Assets-only Worker (no server script): Cloudflare serves dist/ directly.
  // The privacy posture is unchanged — the CSP `connect-src 'none'` still holds;
  // Cloudflare only serves the files, the app still makes zero third-party requests.
  "name": "colonel-kernel",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist"
  }
}
